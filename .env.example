# HeyGen — video & owner twin generation
HEYGEN_API_KEY=your_heygen_api_key_here

# Anthropic — AI script writing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server port (Railway sets this automatically)
PORT=3000

# Persistent data directory
# Railway: set to /data (your volume mount path)
# Local:   leave unset — defaults to project root
# DATA_DIR=/data
