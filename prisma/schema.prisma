generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Restaurant {
  id                   Int      @id @default(autoincrement())
  name                 String
  cuisineType          String?
  location             String?
  ownerName            String?
  tagline              String?
  brandColorPrimary    String?
  brandColorAccent     String?
  brandColorBg         String?
  platforms            String?
  twinStyle            String?
  twinUsecase          String?
  ownerScript          String?
  loginEmail           String?  @unique
  loginPasswordHash    String?
  logoUrl              String?
  ownerPortraitUrl     String?
  instagramAccessToken String?
  instagramUserId      String?
  tokenExpiresAt       DateTime?
  autoPublishEnabled   Boolean  @default(false)
  voiceTone            String?
  defaultHashtags      String?
  includeLocation      Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  foodPhotos      FoodPhoto[]
  scriptTemplates ScriptTemplate[]
  scheduledPosts  ScheduledPost[]
  generationJobs  GenerationJob[]
}

model FoodPhoto {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  photoUrl     String
  caption      String?
  createdAt    DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// topic: welcome | weekend_special | happy_hour | new_menu_item | holiday | general_update | behind_the_scenes | seasonal_menu
model ScriptTemplate {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  templateName String
  topic        String?
  scriptText   String
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
}

// postType: owner_twin_video | cinematic_video | branded_image_feed | branded_image_story
// status:   draft | scheduled | published | failed
model ScheduledPost {
  id               Int       @id @default(autoincrement())
  restaurantId     Int
  postType         String
  contentUrl       String?
  caption          String?
  scheduledTime    DateTime
  status           String    @default("draft")
  instagramPostId  String?
  scriptTemplateId Int?
  publishAttempts  Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scriptTemplate ScriptTemplate? @relation(fields: [scriptTemplateId], references: [id])
  generationJobs GenerationJob[]
}

// jobType:  owner_twin_video | cinematic_video | branded_image_feed | branded_image_story
// status:   pending | processing | completed | failed
model GenerationJob {
  id              Int       @id @default(autoincrement())
  restaurantId    Int
  jobType         String
  externalJobId   String?
  status          String    @default("pending")
  resultUrl       String?
  scheduledPostId Int?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scheduledPost ScheduledPost? @relation(fields: [scheduledPostId], references: [id])
}
